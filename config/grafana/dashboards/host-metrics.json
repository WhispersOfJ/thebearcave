    "showIn": 0,
    "step": "60s",
    "type": "tags"
   }
  ]
 },
 "description": "Host-level metrics: CPU, memory, disk, network, load, filesystem. Sourced from node-exporter.",
 "editable": true,
 "fiscalYearStartMonth": 0,
 "graphTooltip": 1,
 "id": null,
 "links": [],
 "liveNow": false,
 "panels": [
  {
   "title": "CPU Usage",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 20,
      "gradientMode": "opacity",
      "pointSize": 5,
      "showPoints": "never"
     },
     "unit": "percent",
     "min": 0,
     "max": 100
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "CPU % (used)"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "fixedColor": "red",
         "mode": "fixed"
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
     "legendFormat": "CPU % (used)",
     "refId": "A"
    },
    {
     "expr": "avg(rate(node_cpu_seconds_total{mode=\"system\"}[5m])) * 100",
     "legendFormat": "System",
     "refId": "B"
    },
    {
     "expr": "avg(rate(node_cpu_seconds_total{mode=\"user\"}[5m])) * 100",
     "legendFormat": "User",
     "refId": "C"
    },
    {
     "expr": "avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[5m])) * 100",
     "legendFormat": "IO Wait",
     "refId": "D"
    }
   ]
  },
  {
   "title": "Load Average",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 10
     },
     "unit": "short"
    }
   },
   "targets": [
    {
     "expr": "node_load1",
     "legendFormat": "1m",
     "refId": "A"
    },
    {
     "expr": "node_load5",
     "legendFormat": "5m",
     "refId": "B"
    },
    {
     "expr": "node_load15",
     "legendFormat": "15m",
     "refId": "C"
    },
    {
     "expr": "count(node_cpu_seconds_total{mode=\"idle\"})",
     "legendFormat": "CPU Cores",
     "refId": "D"
    }
   ]
  },
  {
   "title": "Memory Usage",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 20,
      "gradientMode": "opacity"
     },
     "unit": "bytes"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Memory % (used)"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "color",
        "value": {
         "fixedColor": "orange",
         "mode": "fixed"
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes",
     "legendFormat": "Used",
     "refId": "A"
    },
    {
     "expr": "node_memory_Cached_bytes",
     "legendFormat": "Cached",
     "refId": "B"
    },
    {
     "expr": "node_memory_Buffers_bytes",
     "legendFormat": "Buffers",
     "refId": "C"
    },
    {
     "expr": "node_memory_SReclaimable_bytes",
     "legendFormat": "SReclaimable",
     "refId": "D"
    },
    {
     "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
     "legendFormat": "Memory % (used)",
     "refId": "E"
    }
   ]
  },
  {
   "title": "Swap Usage",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 15
     },
     "unit": "bytes"
    }
   },
   "targets": [
    {
     "expr": "node_memory_SwapTotal_bytes",
     "legendFormat": "Swap Total",
     "refId": "A"
    },
    {
     "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes",
     "legendFormat": "Swap Used",
     "refId": "B"
    },
    {
     "expr": "node_memory_SwapFree_bytes",
     "legendFormat": "Swap Free",
     "refId": "C"
    }
   ]
  },
  {
   "title": "Disk Usage (/)",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 15
     },
     "unit": "bytes"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Disk % (used)"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "unit",
        "value": "percent"
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "color",
        "value": {
         "fixedColor": "dark-red",
         "mode": "fixed"
        }
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "expr": "node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}",
     "legendFormat": "Used",
     "refId": "A"
    },
    {
     "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}",
     "legendFormat": "Available",
     "refId": "B"
    },
    {
     "expr": "(1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"})) * 100",
     "legendFormat": "Disk % (used)",
     "refId": "C"
    }
   ]
  },
  {
   "title": "Disk I/O",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "palette-classic"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 15
     },
     "unit": "Bps"
    }
   },
   "targets": [
    {
     "expr": "rate(node_disk_read_bytes_total{device!~\"loop.*\"}[5m])",
     "legendFormat": "Read {{ device }}",
     "refId": "A"
    },
    {
     "expr": "rate(node_disk_written_bytes_total{device!~\"loop.*\"}[5m])",
     "legendFormat": "Write {{ device }}",
     "refId": "B"
    }
   ]
  },
  {
   "title": "Network Traffic",
   "type": "timeseries",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
