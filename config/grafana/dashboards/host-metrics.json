{
 "annotations": {
  "list": [
   {
    "name": "Mount Drift",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "enable": true,
    "iconColor": "#F2495C",
    "query": "mount_drift_divergence{job=\"node-exporter\"} == 1",
    "step": "60s",
    "showIn": 0,
    "type": "tags"
   },
   {
    "name": "MCP Baseline",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "enable": true,
    "iconColor": "#FF780A",
    "query": "mcp_baseline_divergence{job=\"node-exporter\"} == 1",
    "step": "60s",
    "showIn": 0,
    "type": "tags"
   },
   {
    "name": "NzbDAV Queue",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "enable": true,
    "iconColor": "#F2495C",
    "query": {
     "expr": "nzbdav_queue_divergence{job=\"node-exporter\"} == 1"
    },
    "showIn": 0,
    "step": "60s",
    "type": "tags"
   },
   {
    "name": "Bind Mount Stale",
    "datasource": {
     "type": "prometheus",
