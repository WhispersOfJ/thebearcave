# ============================================================================
# The Bear Cave — Environment Template
# ============================================================================
# Copy this file to .env and fill in the values.
# All sensitive values should be stored in Docker secrets (see secrets/ directory)
# This file contains non-sensitive configuration and placeholder values.
#
# WARNING: Never commit .env to version control!
# ============================================================================

# ---- Identity / Runtime ----
PUID=1000
PGID=1000
TZ=America/New_York

# ---- Networking ----
HOST_IP=192.168.1.100  # Your server's IP address

# ---- Plex ----
PLEX_URL=http://HOST_IP:32400
# ---- Service URLs (direct, bypass Traefik) ----
RADARR_URL=http://HOST_IP:7878
SONARR_URL=http://HOST_IP:8989
PROWLARR_URL=http://HOST_IP:9696
NZBDAV_URL=http://HOST_IP:3000
WATCHSTATE_URL=http://HOST_IP:8705
SEERR_URL=http://HOST_IP:5055

PLEX_TOKEN=changeme

# ---- Traefik Dashboard ----
# Generate with: htpasswd -nB admin | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$changeme

# ---- InfiniDysk (nzbdav) ----
FRONTEND_BACKEND_API_KEY=changeme
NZBDAV_WEBDAV_USER=usenet
# IMPORTANT: rclone.conf requires rclone-obfuscated passwords, not plaintext.
# Generate with: rclone obscure "your-password-here"
NZBDAV_WEBDAV_PASS=changeme
NZBDAV_RCLONE_RC_PASS=changeme
NZBDAV_PROFILE_TOKEN=changeme

# ---- Usenet Providers ----
NZBDAV_USENET_HOST=changeme
NZBDAV_USENET_PORT=563
NZBDAV_USENET_USER=changeme
NZBDAV_USENET_PASS=changeme

NZBDAV_USENET_BACKUP_HOST=changeme
NZBDAV_USENET_BACKUP_PORT=563
NZBDAV_USENET_BACKUP_USER=changeme
NZBDAV_USENET_BACKUP_PASS=changeme

# ---- *arr API Keys ----
RADARR_API_KEY=changeme
SONARR_API_KEY=changeme
PROWLARR_API_KEY=changeme

# ---- Phase 1 *arr API Keys ----
LIDARR_API_KEY=changeme
READARR_API_KEY=changeme

# ---- Metacache ----
TMDB_KEY=changeme
TVDB_KEY=changeme
METACACHE_API_KEY=changeme
WARM_LANG_0=en-US

# ---- WatchState ----
WS_API_KEY=changeme
WS_SYSTEM_SECRET=changeme


# ---- AdGuard Home ----
ADGUARD_ADMIN_USER=admin
ADGUARD_ADMIN_PASSWORD=changeme

# ---- Phase 3 utilities ----
VAULTWARDEN_ADMIN_TOKEN=changeme
N8N_ENCRYPTION_KEY=changeme
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# ---- External APIs ----
OMDB_KEY=changeme
MDBLIST_KEY=changeme
FANART_KEY=changeme

# ---- Discord ----
DISCORD_WEBHOOK_URL=changeme

# ---- Grafana ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# ---- GitHub (release-please) ----
# Optional: classic PAT (repo scope) or fine-grained PAT (contents + pull-
# requests write) used by release-please to open the release PR. PRs opened
# with this token trigger validate.yml; PRs opened with the default
# GITHUB_TOKEN do not (GitHub recursion guard). GitHub Actions reads this
# ONLY from the repo Actions secret — run `./scripts/setup.sh` (or
# `--sync-github-secrets`) after changing it here to push the value to GitHub.
RELEASE_PLEASE_TOKEN=
