{
  "annotations": { "list": [] },
  "description": "NzbDAV streaming performance: queue depth, active downloads, download rate, history success/failure, API latency, config overview. Data from nzbdav-exporter + cAdvisor.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "NzbDAV Status",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      },
      "options": { "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "nzbdav_up", "legendFormat": "Up", "refId": "A" }
      ]
    },
    {
      "title": "Active Downloads",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 3 },
            { "color": "red", "value": 6 }
          ] }
        }
      },
      "options": { "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "nzbdav_queue_active_downloads", "legendFormat": "Active", "refId": "A" }
      ]
    },
    {
      "title": "Queue Items",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 10 },
            { "color": "red", "value": 30 }
          ] }
        }
      },
      "options": { "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "nzbdav_queue_items_total", "legendFormat": "Items", "refId": "A" }
      ]
    },
    {
      "title": "Queue Depth",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1073741824 },
            { "color": "red", "value": 10737418240 }
          ] }
        }
      },
      "options": { "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "nzbdav_queue_depth_bytes", "legendFormat": "Depth", "refId": "A" }
      ]
    },
    {
      "title": "Success Ratio",
      "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0, "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.85 },
            { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "targets": [
        { "expr": "nzbdav_history_success_ratio", "legendFormat": "Ratio", "refId": "A" }
      ]
    },
    {
      "title": "API Latency",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ] }
        }
      },
      "options": { "textMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "nzbdav_scrape_duration_seconds", "legendFormat": "Scrape", "refId": "A" }
      ]
    },

    {
      "title": "Active Downloads Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "gradientMode": "opacity", "showPoints": "never" },
          "unit": "short", "min": 0
        }
      },
      "targets": [
        { "expr": "nzbdav_queue_active_downloads", "legendFormat": "Active Downloads", "refId": "A" },
        { "expr": "nzbdav_config_queue_worker_count", "legendFormat": "Worker Limit", "refId": "B" }
      ]
    },
    {
      "title": "Queue Depth (bytes remaining)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 },
          "unit": "bytes"
        }
      },
      "targets": [
        { "expr": "nzbdav_queue_depth_bytes", "legendFormat": "Total Remaining", "refId": "A" }
      ]
    },

    {
      "title": "Queue by Category",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 50, "stacking": { "mode": "normal" } },
          "unit": "bytes"
        }
      },
      "targets": [
        { "expr": "nzbdav_queue_per_category_bytes", "legendFormat": "{{ cat }}", "refId": "A" }
      ]
    },
    {
      "title": "Queue by Status",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 50, "stacking": { "mode": "normal" } },
          "unit": "short"
        }
      },
      "targets": [
        { "expr": "nzbdav_queue_per_status_count", "legendFormat": "{{ status }}", "refId": "A" }
      ]
    },

    {
      "title": "History: Completed vs Failed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 },
          "unit": "short"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Completed" }, "properties": [
            { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
          ] },
          { "matcher": { "id": "byName", "options": "Failed" }, "properties": [
            { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
          ] }
        ]
      },
      "targets": [
        { "expr": "nzbdav_history_completed_total", "legendFormat": "Completed", "refId": "A" },
        { "expr": "nzbdav_history_failed_total", "legendFormat": "Failed", "refId": "B" }
      ]
    },
    {
      "title": "Success Ratio Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "percentunit", "min": 0, "max": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "red", "value": null },
            { "color": "yellow", "value": 0.85 },
            { "color": "green", "value": 0.95 }
          ] }
        }
      },
      "targets": [
        { "expr": "nzbdav_history_success_ratio", "legendFormat": "Success Ratio", "refId": "A" }
      ]
    },

    {
      "title": "API Latency Breakdown",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        { "expr": "nzbdav_api_latency_seconds", "legendFormat": "Queue API", "refId": "A" },
        { "expr": "nzbdav_api_latency_seconds_history", "legendFormat": "History API", "refId": "B" },
        { "expr": "nzbdav_api_latency_seconds_config", "legendFormat": "Config API", "refId": "C" },
        { "expr": "nzbdav_api_latency_seconds_health", "legendFormat": "Healthz", "refId": "D" }
      ]
    },
    {
      "title": "Exporter Scrape Duration",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "purple", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 },
          "unit": "s"
        }
      },
      "targets": [
        { "expr": "nzbdav_scrape_duration_seconds", "legendFormat": "Total Scrape", "refId": "A" }
      ]
    },

    {
      "title": "Config Overview",
      "type": "table",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "text", "value": null }] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Value" }, "properties": [
            { "id": "custom.cellOptions", "value": { "type": "color-background" } }
          ] }
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": {
          "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
          "renameByName": { "Metric": "Setting", "Value": "Value" }
        }}
      ],
      "targets": [
        { "expr": "nzbdav_config_segment_cache_enabled", "legendFormat": "Segment Cache", "refId": "A", "format": "table", "instant": true },
        { "expr": "nzbdav_config_segment_cache_max_gb", "legendFormat": "Cache Max GB", "refId": "B", "format": "table", "instant": true },
        { "expr": "nzbdav_config_queue_worker_count", "legendFormat": "Worker Count", "refId": "C", "format": "table", "instant": true },
        { "expr": "nzbdav_config_pipelining_depth", "legendFormat": "Pipelining Depth", "refId": "D", "format": "table", "instant": true },
        { "expr": "nzbdav_config_repair_enabled", "legendFormat": "Repair Enabled", "refId": "E", "format": "table", "instant": true },
        { "expr": "nzbdav_config_watchdog_enabled", "legendFormat": "Watchdog Enabled", "refId": "F", "format": "table", "instant": true },
        { "expr": "nzbdav_config_max_connections_per_stream", "legendFormat": "Per-Stream Conn Cap", "refId": "G", "format": "table", "instant": true }
      ]
    },
    {
      "title": "NzbDAV Container CPU",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 },
          "unit": "percent", "min": 0
        }
      },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name=\"nzbdav\"}[5m]) * 100", "legendFormat": "CPU %", "refId": "A" }
      ]
    },
    {
      "title": "NzbDAV Container Memory",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 },
          "unit": "bytes"
        }
      },
      "targets": [
        { "expr": "container_memory_usage_bytes{name=\"nzbdav\"}", "legendFormat": "Usage", "refId": "A" },
        { "expr": "container_spec_memory_limit_bytes{name=\"nzbdav\",container_spec_memory_limit_bytes!=\"0\"}", "legendFormat": "Limit", "refId": "B" }
      ]
    },

    {
      "title": "NzbDAV Rclone Container CPU",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "dark-orange", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 },
          "unit": "percent", "min": 0
        }
      },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total{name=\"nzbdav_rclone\"}[5m]) * 100", "legendFormat": "CPU %", "refId": "A" }
      ]
    },
    {
      "title": "NzbDAV Rclone Container Memory",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "dark-blue", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 },
          "unit": "bytes"
        }
      },
      "targets": [
        { "expr": "container_memory_usage_bytes{name=\"nzbdav_rclone\"}", "legendFormat": "Usage", "refId": "A" },
        { "expr": "container_spec_memory_limit_bytes{name=\"nzbdav_rclone\",container_spec_memory_limit_bytes!=\"0\"}", "legendFormat": "Limit", "refId": "B" }
      ]
    },
    {
      "title": "NzbDAV Rclone Network I/O",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 15 },
          "unit": "Bps"
        }
      },
      "targets": [
        { "expr": "rate(container_network_receive_bytes_total{name=\"nzbdav_rclone\"}[5m])", "legendFormat": "RX", "refId": "A" },
        { "expr": "rate(container_network_transmit_bytes_total{name=\"nzbdav_rclone\"}[5m])", "legendFormat": "TX", "refId": "B" }
      ]
    },
    {
      "title": "NzbDAV Restarts",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ] }
        }
      },
      "options": { "textMode": "value_and_name", "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "targets": [
        { "expr": "container_oom_events_total{name=~\"nzbdav|nzbdav_rclone\"}", "legendFormat": "{{ name }}", "refId": "A" }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["nzbdav", "usenet", "streaming", "performance"],
  "templating": {
    "list": [
      { "name": "DS_PROMETHEUS", "type": "datasource", "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" }, "hide": 0 }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "NzbDAV Streaming Performance",
  "uid": "nzbdav-streaming",
  "version": 1
}
