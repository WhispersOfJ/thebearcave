# ============================================================================
# The Bear Cave — .gitignore
# ============================================================================

# Environment and secrets
.env
.env.local
.env.*.local
secrets/
archive/metacacharr/monitoring/.env

# Service configuration (contains sensitive data). After the Phase 4
# migration every app's live config lives under config/<app>/ (Plex library,
# *arr DBs + API keys, WebDAV creds, control-panel.db) — none of it is
# trackable. Only config/traefik/ (static config + dynamic TLS routing) is
# tracked; the mkcert private key under config/traefik/certs/ must never be.
config/*/
!config/traefik/
!config/grafana/
!config/prometheus/
config/traefik/certs/
config/nzbdav-rclone/cache/
config/nzbdav-rclone/rclone.conf
config/alertmanager/
!config/alertmanager/alertmanager.yml.template

# Persistent data volumes
data/
logs/

# Unpackerr download staging
usenet/

# Media symlinks (populated by rclone)
media/movies/*
media/shows/*
media/anime-movies/*
media/anime-shows/*
!media/movies/.gitkeep
!media/shows/.gitkeep
!media/anime-movies/.gitkeep
!media/anime-shows/.gitkeep

# Docker
docker-compose.override.yml

# Ansible (local inventory names your LAN devices)
ansible/hosts.yml
ansible/hosts.ini
ansible/hosts

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/

# .NET (metacache)
services/metacache/bin/
services/metacache/obj/
services/metacache/**/bin/
services/metacache/**/obj/
archive/metacacharr/**/bin/
archive/metacacharr/**/obj/
archive/metacacharr/**/*.dll
archive/metacacharr/**/*.pdb
archive/metacacharr/**/*.exe
archive/metacacharr/**/project.assets.json
archive/metacacharr/**/TestResults/

# Logs
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# Freebuff client workspace state (lives inside the repo via the symlink at ~/Projects/The Bear Cave)
.freebuff/
data/alertmanager/
